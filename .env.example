# ═══════════════════════════════════════════════════════════════
# ASP.NET Core / Host
# ═══════════════════════════════════════════════════════════════
ASPNETCORE_ENVIRONMENT=dev

JWT_SECRET=
JWT_ISSUER=Portfolio.Api
JWT_AUDIENCE=Portfolio.Client

# ═══════════════════════════════════════════════════════════════
# Kestrel (Portas)
# ═══════════════════════════════════════════════════════════════
KESTREL_HTTP_PORT=5000
KESTREL_HTTPS_PORT=5001

# ═══════════════════════════════════════════════════════════════
# HTTPS / Certificados
# ═══════════════════════════════════════════════════════════════
HTTPS_CERTIFICATE_PEM_PATH=certs/fullchain.pem
HTTPS_CERTIFICATE_KEY_PATH=certs/privkey.pem
# Protocolos separados por vírgula ou ponto e vírgula
HTTPS_SSL_PROTOCOLS=Tls12,Tls13
HTTPS_CLIENT_CERT_MODE=NoCertificate

# ═══════════════════════════════════════════════════════════════
# CORS (Separe múltiplos valores por vírgula ou ponto e vírgula)
# ═══════════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=https://localhost:4200,https://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,HEAD
ALLOW_HEADERS=Authorization,Content-Type,X-Requested-With
ALLOW_EXPOSED_HEADERS=X-Total-Count,X-Pagination,X-Custom-Header
ALLOW_CREDENTIALS=true
PREFLIGHT_MAX_AGE_IN_SECONDS=600

# ═══════════════════════════════════════════════════════════════
# Swagger
# ═══════════════════════════════════════════════════════════════
SWAGGER_TITLE=Portfolio API
SWAGGER_DESCRIPTION=API example for my portfolio.
SWAGGER_VERSION=v1
SWAGGER_ENABLE_AUTH=true

# ═══════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DATABASE=

# ═══════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════
SONAR_DB=sonar
SONAR_DB_USER=admin
SONAR_DB_PASSWORD=admin