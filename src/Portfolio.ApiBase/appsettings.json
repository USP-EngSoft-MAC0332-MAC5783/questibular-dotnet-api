{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "HEAD"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "X-Requested-With"
    ],
    "ExposedHeaders": [
      "X-Total-Count",
      "X-Pagination",
      "X-Custom-Header"
    ],
    "AllowCredentials": true,
    "PreflightMaxAgeInSeconds": 600
  },
  "Https": {
    "CertificatePemPath": "certs/fullchain.pem",
    "CertificateKeyPath": "certs/privkey.pem",
    "SslProtocols": [ "Tls12", "Tls13" ],
    "ClientCertificateMode": "NoCertificate"
  },
  "Kestrel": {
    "HttpPort": 5000,
    "HttpsPort": 5001
  },
  "Swagger": {
    "Title": "Portfolio API",
    "Description": "API example for my portfolio.",
    "Version": "v1",
    "ContactName": "Yago Pereira",
    "ContactEmail": "yago.henriquep@gmail.com",
    "ContactUrl": "https://www.linkedin.com/in/yago-henrique-pereira-5328789a",
    "EnableJwtAuth": true,
    "AuthSchemeName": "Bearer"
  }
}